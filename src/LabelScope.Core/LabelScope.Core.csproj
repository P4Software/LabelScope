<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public members must carry XML docs (project rule), so missing docs are errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests drive the listener's internal accept loop with an injected failure. -->
    <InternalsVisibleTo Include="LabelScope.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <!-- PDF417 codeword tables and encoder (Apache-2.0); its attribution and licence text are in
         THIRD-PARTY-NOTICES.txt. Exact version, kept equal to the test project's
         reference so the app and its decoder tests use the same library. -->
    <PackageReference Include="ZXing.Net" Version="[0.16.9]" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled open-licence fonts (SIL OFL 1.1, see THIRD-PARTY-NOTICES.txt section G), embedded unmodified so labels
         look the same on every PC whether or not Arial or any other font is installed. -->
    <EmbeddedResource Include="Fonts\Files\*.ttf" LogicalName="LabelScope.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
