<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public members must carry XML docs (project rule), so missing docs are errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests drive the listener's internal accept loop with an injected failure. -->
    <InternalsVisibleTo Include="LabelScope.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <!-- PDF417 codeword tables and encoder (Apache-2.0); listed in THIRD-PARTY-NOTICES.txt. Exact version, kept
         equal to the test project's reference so the app and its decoder tests use the same library. -->
    <PackageReference Include="ZXing.Net" Version="[0.16.9]" />
  </ItemGroup>

</Project>
