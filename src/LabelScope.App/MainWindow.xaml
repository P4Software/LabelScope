<Window x:Class="LabelScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelScope" Height="760" Width="1200" MinHeight="480" MinWidth="800"
        Icon="labelscope.ico" Loaded="OnLoaded" Closing="OnClosing">
  <DockPanel>

    <ToolBar DockPanel.Dock="Top">
      <Button x:Name="InstallButton" Content="Install printer" Click="OnInstallPrinter" ToolTip="Adds the Windows printer that sends labels to LabelScope"/>
      <Button x:Name="RemoveButton" Content="Remove printer" Click="OnRemovePrinter"/>
      <Separator/>
      <Button Content="Save PNG" Click="OnSavePng"/>
      <Button Content="Copy image" Click="OnCopyImage"/>
      <Button Content="Clear history" Click="OnClearHistory"/>
      <Separator/>
      <Button Content="Open settings" Click="OnOpenSettings"/>
      <Button Content="Open log folder" Click="OnOpenLog"/>
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom">
      <TextBlock x:Name="ListeningText" Text="Starting..."/>
      <Separator/>
      <TextBlock x:Name="PrinterText" Text="Printer: checking..."/>
      <Separator/>
      <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="140"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- History: newest label first -->
      <ListBox x:Name="HistoryList" Grid.Column="0" SelectionChanged="OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding Subtitle}" Foreground="Gray" FontSize="11"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

      <!-- Label picture (left) and ZPL (right), always visible together -->
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="200"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="*" MinWidth="200"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <CheckBox x:Name="FitBox" Content="Fit to window" IsChecked="True" VerticalAlignment="Center"
                      Checked="OnZoomChanged" Unchecked="OnZoomChanged"/>
            <TextBlock Text="Zoom" Margin="12,0,4,0" VerticalAlignment="Center"/>
            <Slider x:Name="ZoomSlider" Width="120" Minimum="0.25" Maximum="4" Value="1" ValueChanged="OnZoomSliderChanged"/>
          </StackPanel>
          <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Margin="6,0,6,4" Foreground="Gray"/>
          <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Background="#FFDDDDDD" SizeChanged="OnZoomChanged">
            <Image x:Name="LabelImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
          </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="130" MinHeight="40"/>
          </Grid.RowDefinitions>

          <!-- Header: caption on the left, copy buttons on the right. Disabled until a label is selected. -->
          <DockPanel Grid.Row="0" Margin="4,2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="CopyZplButton" Content="Copy" IsEnabled="False" Padding="8,1" Margin="0,0,4,0"
                      Click="OnCopyZpl" ToolTip="Copy the ZPL shown below"/>
              <Button x:Name="CopyOriginalButton" Content="Copy original" IsEnabled="False" Padding="8,1"
                      Click="OnCopyOriginalZpl" ToolTip="Copy the ZPL exactly as it was received"/>
            </StackPanel>
            <TextBlock Text="ZPL" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>

          <!-- Line numbers sit in the same scroll area as the text so both always scroll together,
               while the text box itself stays clean to copy. -->
          <ScrollViewer Grid.Row="1" x:Name="ZplScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LineNumbers" Grid.Column="0" FontFamily="Consolas" FontSize="13" Padding="4,0,8,0"
                         Foreground="Gray" TextAlignment="Right"/>
              <TextBox x:Name="ZplBox" Grid.Column="1" FontFamily="Consolas" FontSize="13" Padding="0"
                       IsReadOnly="True" BorderThickness="0" AcceptsReturn="True" TextWrapping="NoWrap"
                       IsInactiveSelectionHighlightEnabled="True" PreviewMouseWheel="OnZplMouseWheel"/>
            </Grid>
          </ScrollViewer>

          <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>

          <ListBox x:Name="WarningList" Grid.Row="3" SelectionChanged="OnWarningSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap">
                  <Run Text="Line "/><Run Text="{Binding Line, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding Message, Mode=OneWay}"/>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
