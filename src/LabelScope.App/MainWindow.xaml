<!--
  The main window (0.4.0 layout, mockup "Main window"): toolbar, Print jobs card on the left, the label on a canvas in
  the centre, ZPL / Fields / Log tabs on the right, status bar at the bottom.

  Every visible text is set from code (MainWindow.ApplyTexts) through UiText, so a language switch only has to call
  that one method again. The texts written here are design-time placeholders only.
-->
<Window x:Class="LabelScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LabelScope.App.Controls"
        Style="{StaticResource AppWindow}"
        Title="LabelScope" Height="760" Width="1200" MinHeight="560" MinWidth="960"
        Icon="labelscope.ico" Loaded="OnLoaded" Closing="OnClosing">
  <DockPanel>

    <!-- ================================================================ Toolbar -->
    <!-- When the window is too narrow for every label, the flat buttons drop their text and keep the icon
         (MainWindow.UpdateToolbarFit); the text then shows as a tooltip. -->
    <Border x:Name="ToolbarBar" DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8"
            SizeChanged="OnToolbarSizeChanged">
      <DockPanel LastChildFill="False">
        <StackPanel x:Name="ToolbarLeft" DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="OpenFileButton" Style="{StaticResource PrimaryButton}" Tag="{StaticResource IconOpenFolder}"
                  Content="Open ZPL file" Click="OnOpenFile" Margin="0,0,12,0"/>
          <Button x:Name="PasteButton" Style="{StaticResource ToolbarButton}" Tag="{StaticResource IconPaste}"
                  Content="Paste ZPL" Click="OnPasteZpl" Margin="0,0,4,0"/>
          <Button x:Name="CopyZplButton" Style="{StaticResource ToolbarButton}" Tag="{StaticResource IconCopy}"
                  Content="Copy ZPL" Click="OnCopyZpl" IsEnabled="False" Margin="0,0,4,0"/>
          <Button x:Name="SavePngButton" Style="{StaticResource ToolbarButton}" Tag="{StaticResource IconImage}"
                  Content="Save as PNG" Click="OnSavePng" Margin="0,0,4,0"/>
          <Button x:Name="ClearJobsButton" Style="{StaticResource ToolbarButton}" Tag="{StaticResource IconDelete}"
                  Content="Clear jobs" Click="OnClearHistory"/>
        </StackPanel>

        <StackPanel x:Name="ToolbarRight" DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="ZoomOutButton" Style="{StaticResource ToolbarButton}" Tag="{StaticResource IconMinus}"
                  Click="OnZoomOut" Padding="10,7"/>
          <Button x:Name="FitButton" Style="{StaticResource ToolbarButton}" Content="Fit 100%" Click="OnFit"
                  MinWidth="76" Padding="8,7"/>
          <Button x:Name="ZoomInButton" Style="{StaticResource ToolbarButton}" Tag="{StaticResource IconPlus}"
                  Click="OnZoomIn" Padding="10,7" Margin="0,0,12,0"/>
          <!-- Read-only for now: shows the label loaded in the printer. Choosing a size arrives with the settings work. -->
          <ComboBox x:Name="SizePicker" Style="{StaticResource DropDown}" Margin="0,0,10,0" MinWidth="170"/>
          <ComboBox x:Name="LanguagePicker" Style="{StaticResource DropDown}" Margin="0,0,10,0" MinWidth="124"
                    SelectionChanged="OnLanguageChanged">
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="Español" Tag="es"/>
          </ComboBox>
          <!-- Shown only when a newer version was found, as in 0.3. -->
          <Button x:Name="UpdateButton" Style="{StaticResource OutlineButton}" Tag="{StaticResource IconDownload}"
                  Visibility="Collapsed" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"
                  Click="OnUpdateNow" Margin="0,0,10,0"/>
          <Button x:Name="PrinterSetupButton" Style="{StaticResource OutlineButton}" Tag="{StaticResource IconPrint}"
                  Content="Printer setup" Click="OnPrinterSetup">
            <Button.ContextMenu>
              <ContextMenu x:Name="PrinterMenu">
                <MenuItem x:Name="InstallButton" Header="Install printer" Click="OnInstallPrinter"/>
                <MenuItem x:Name="RemoveButton" Header="Remove printer" Click="OnRemovePrinter"/>
                <Separator/>
                <MenuItem x:Name="PrinterSettingsItem" Header="Open settings" Click="OnOpenSettings"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="MoreButton" Style="{StaticResource ToolbarButton}" Tag="{StaticResource IconMore}"
                  Click="OnMore" Padding="10,7" Margin="6,0,0,0">
            <Button.ContextMenu>
              <ContextMenu x:Name="MoreMenu">
                <MenuItem x:Name="InstallItem" Header="Install printer" Click="OnInstallPrinter"/>
                <MenuItem x:Name="RemoveItem" Header="Remove printer" Click="OnRemovePrinter"/>
                <Separator/>
                <MenuItem x:Name="CopyImageItem" Header="Copy image" Click="OnCopyImage"/>
                <MenuItem x:Name="CopyOriginalButton" Header="Copy original ZPL" Click="OnCopyOriginalZpl" IsEnabled="False"/>
                <MenuItem x:Name="ClearMemoryButton" Header="Clear printer memory" Click="OnClearMemory"/>
                <Separator/>
                <MenuItem x:Name="GridBox" Header="Light grid (10 mm)" IsCheckable="True"
                          Checked="OnViewOptionChanged" Unchecked="OnViewOptionChanged"/>
                <MenuItem x:Name="StackedBox" Header="Stacked layout" IsCheckable="True"
                          Checked="OnViewOptionChanged" Unchecked="OnViewOptionChanged"/>
                <Separator/>
                <MenuItem x:Name="OpenSettingsItem" Header="Open settings" Click="OnOpenSettings"/>
                <MenuItem x:Name="OpenLogItem" Header="Open log folder" Click="OnOpenLog"/>
                <MenuItem x:Name="CheckUpdateButton" Header="Check for updates" Click="OnCheckForUpdates"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================================================================ Status bar -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBarPanel}" Background="{StaticResource CardBrush}">
      <DockPanel>
        <!-- Docked right and declared first so it keeps its room; the label facts get the rest. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="MemoryText" Style="{StaticResource StatusText}" Text="Memory: empty"/>
          <TextBlock x:Name="ReceivedText" Style="{StaticResource StatusText}" Margin="0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="BarLabelText" Style="{StaticResource StatusText}"/>
          <TextBlock x:Name="BarSizeText" Style="{StaticResource StatusText}"/>
          <TextBlock x:Name="BarLinesText" Style="{StaticResource StatusText}"/>
          <TextBlock x:Name="BarWarningsText" Style="{StaticResource StatusTextSuccess}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ================================================================ Message strip -->
    <!-- Results of actions and start-up notes. Hidden while there is nothing to say, so the normal view matches the
         mockup; the cross dismisses what is shown. -->
    <Border x:Name="MessageBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{StaticResource HoverFillBrush}"
            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,6,8,6">
      <DockPanel>
        <Button x:Name="DismissMessageButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}"
                Content="✕" FontSize="11" Padding="8,2" Click="OnDismissMessage" VerticalAlignment="Top"/>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxHeight="40" TextTrimming="WordEllipsis"
                   VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      </DockPanel>
    </Border>

    <!-- ================================================================ Body -->
    <Grid Margin="16,16,16,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="220"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ====== Print jobs card -->
      <ContentControl Grid.Column="0" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="22,18,22,14">
            <TextBlock x:Name="ReceivedTodayText" DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"/>
            <!-- Wraps rather than running into the count when the title is long (Spanish). -->
            <TextBlock x:Name="JobsTitleText" Style="{StaticResource CardTitleText}" Text="Print jobs"
                       TextWrapping="Wrap" Margin="0,0,10,0"/>
          </DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,1"
                  Padding="22,10">
            <DockPanel>
              <TextBlock x:Name="StatusIcon" DockPanel.Dock="Left" Style="{StaticResource IconText}"
                         VerticalAlignment="Top" Margin="0,3,8,0"/>
              <TextBlock x:Name="StatusLineText" TextWrapping="Wrap"/>
            </DockPanel>
          </Border>

          <!-- Newest job first. -->
          <ListBox x:Name="HistoryList" Style="{StaticResource JobList}" ItemContainerStyle="{StaticResource JobCard}"
                   SelectionChanged="OnSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText, Mode=OneWay}"
                               Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding JobName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Text="{Binding CardDetail, Mode=OneWay}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="CardStatus" Text="{Binding CardStatus, Mode=OneWay}"
                             Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsError, Mode=OneWay}" Value="True">
                    <Setter TargetName="CardStatus" Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </ContentControl>

      <!-- Picture card and ZPL card side by side (default) or stacked; MainWindow.ApplyLayout rearranges them. -->
      <Grid Grid.Column="2" x:Name="PreviewGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="440" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- ====== Canvas card -->
        <Border Grid.Column="0" x:Name="PicturePane" Style="{StaticResource CardBorder}"
                Background="{StaticResource BackgroundBrush}">
          <Grid>
            <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                          SizeChanged="OnZoomChanged" Focusable="False">
              <Grid x:Name="LabelStage" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TopCaption" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"
                           Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                <TextBlock x:Name="SideCaption" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource MutedText}" Margin="0,0,8,0">
                  <TextBlock.LayoutTransform>
                    <RotateTransform Angle="-90"/>
                  </TextBlock.LayoutTransform>
                </TextBlock>

                <!-- The shadow sits on its own layer behind the label so the picture is never drawn through an effect. -->
                <Grid x:Name="LabelFrame" Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
                  <Border Background="White">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.14" Color="#1B2430"/>
                    </Border.Effect>
                  </Border>
                  <Border BorderBrush="#9AA5B4" BorderThickness="1" Background="White" SnapsToDevicePixels="True">
                    <!-- The overlay has no size of its own, so it always covers exactly the picture. -->
                    <Grid>
                      <Image x:Name="LabelImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                      <Rectangle x:Name="GridOverlay" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
            </ScrollViewer>
            <TextBlock x:Name="EmptyCanvasText" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" FontSize="14"/>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" x:Name="PreviewSplitter" Width="16" HorizontalAlignment="Stretch"
                      Background="Transparent"/>

        <!-- ====== ZPL / Fields / Log card -->
        <ContentControl Grid.Column="2" x:Name="ZplPane" Style="{StaticResource Card}">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
                    Padding="22,12">
              <TextBlock x:Name="SelectedText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Border>
            <!-- The selected tab header is SemiBold; the pages reset the weight so it does not pass on to their text. -->
            <TabControl x:Name="DetailTabs" Style="{StaticResource UnderlineTabControl}">
              <TabItem x:Name="ZplTab" Style="{StaticResource UnderlineTabItem}" Header="ZPL">
                <controls:ZplEditor x:Name="ZplView" FontWeight="Normal" Foreground="{StaticResource TextBrush}"/>
              </TabItem>
              <TabItem x:Name="FieldsTab" Style="{StaticResource UnderlineTabItem}" Header="Fields">
                <TextBlock x:Name="FieldsPlaceholderText" FontWeight="Normal" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="24" FontSize="14"/>
              </TabItem>
              <TabItem x:Name="LogTab" Style="{StaticResource UnderlineTabItem}" Header="Log">
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="{StaticResource TextBrush}">
                  <ListBox x:Name="WarningList" BorderThickness="0" Background="Transparent" Padding="0,6"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnWarningSelected">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="22,8"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel>
                          <TextBlock Text="{Binding LineText, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource ErrorBrush}"/>
                          <TextBlock Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="LogEmptyText" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                             TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="24" FontSize="14"/>
                </Grid>
              </TabItem>
            </TabControl>
          </DockPanel>
        </ContentControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
