<!--
  Read-only ZPL panel: AvalonEdit text editor with ZPL colouring, a line-number gutter and one highlighted line.
  The behaviour lives in ZplEditor.xaml.cs; this file only sets the editor's fixed look.
-->
<UserControl x:Class="LabelScope.App.Controls.ZplEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
  <!-- Word wrap off and a horizontal scroll bar: a ZPL line is one command group and should stay on one row,
       so line numbers in warnings and the Fields tab match what the user sees. -->
  <avalonedit:TextEditor x:Name="Editor"
                         IsReadOnly="True"
                         WordWrap="False"
                         ShowLineNumbers="False"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="0,8,0,8"
                         Background="#F7F8FA"
                         Foreground="#1B2430"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto" />
</UserControl>
